# Chave do Google AI Studio com acesso ao modelo de vídeo e faturamento habilitado.
# Preencha somente backend/.env ou os secrets do servidor. Nunca use VITE_ para chaves.
GEMINI_API_KEY=

# Modelos atuais da Gemini API. Veo 3.1 Preview foi desativado em 22/10/2026.
VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_CHAT_MODEL=gemini-3.8-flash

PORT=3000
# Opcional: origem exata do front-end, sem caminho/barra final.
# Exemplo para GitHub Pages: https://breno423.github.io
FRONTEND_ORIGIN=

# Opcional, apenas para os provedores alternativos de imagem que já existiam.
HF_TOKEN=
